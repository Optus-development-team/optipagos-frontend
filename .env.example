# Número de WhatsApp de Optipagos (formato internacional, solo dígitos). Lo usan los botones
# "Abrir en WhatsApp" y "Volver a WhatsApp".
NEXT_PUBLIC_WHATSAPP_NUMBER=59170000000

# Dónde escucha optipagos-backend. El frontend reenvía ahí /api/v1/{actions,auth,webhooks}
# (API de la página de confirmación, vínculo con Google y webhook de WhatsApp).
# Se lee al compilar (next build).
BACKEND_URL=http://127.0.0.1:3200

# Solo desarrollo: hosts extra que pueden abrir `next dev` (IP de la red local, túnel…).
# DEV_ORIGINS=192.168.1.57,*.ngrok-free.dev
