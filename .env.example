# ── Direcciones ──────────────────────────────────────────────────────────────
# URL pública de este sitio. De aquí salen las URL canónicas, el sitemap y las tarjetas de
# vista previa. Producción: https://optipagos.optus.lat
NEXT_PUBLIC_SITE_URL=https://optipagos.optus.lat

# URL pública de la API cuando tiene dominio propio. Con este valor el navegador la llama
# directamente (el backend lo permite por CORS). Producción: https://api.optipagos.optus.lat
# Déjala vacía en local o detrás de un único túnel: el sitio reenvía /api/v1 al backend.
NEXT_PUBLIC_API_URL=https://api.optipagos.optus.lat

# Dirección del backend vista desde el servidor de este sitio (páginas de comprobantes y
# reenvío de /api/v1/{actions,auth,webhooks,receipts}). Si no se define se usa
# NEXT_PUBLIC_API_URL y, si tampoco, http://127.0.0.1:3200. Se lee al compilar.
# BACKEND_URL=http://127.0.0.1:3200

# ── WhatsApp ─────────────────────────────────────────────────────────────────
# Número de Optipagos (formato internacional, solo dígitos) para los botones
# "Abrir en WhatsApp" y "Volver a WhatsApp".
NEXT_PUBLIC_WHATSAPP_NUMBER=59170000000

# ── Solo desarrollo ──────────────────────────────────────────────────────────
# Hosts extra que pueden abrir `next dev` (IP de la red local, túnel…).
# DEV_ORIGINS=192.168.1.57,*.ngrok-free.dev
# Carpeta de compilación alternativa (para probar sin tocar la que está en servicio).
# NEXT_DIST_DIR=.next-test

# ── Beta cerrada (Google Sheets) ─────────────────────────────────────────────
# Aplicación web de Apps Script que guarda los registros en una hoja. Solo servidor: no
# lleva NEXT_PUBLIC_. Pasos en docs/beta-google-sheets.md.
# BETA_SHEET_URL=https://script.google.com/macros/s/XXXXXXXX/exec
# BETA_SHEET_SECRET=una-clave-larga-y-aleatoria
